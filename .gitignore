# =====================================================================
# .gitignore for Shelter from the Storm — Salesforce build
# Safety-tuned: explicit deny-list for anything that could leak
# real client data, credentials, or session tokens.
# =====================================================================

# --- Salesforce CLI auth and local state ---
.sfdx/
.sf/
.localdevserver/

# --- Salesforce build artifacts / scratch outputs ---
*.log
deploy-options.json
package.xml.bak
**/__tests__/coverage/

# --- Credentials, secrets, tokens — NEVER commit ---
*.env
.env*
*.key
*.pem
*.cer
*.crt
*credentials*
*secret*
*token*
auth/
.auth-url

# --- Real client data safety net (explicit deny) ---
# These folder names are reserved. If you see one of these in your
# project, STOP. Move the data out of the project folder entirely.
private/
confidential/
real-data/
client-data/
production-export/
survivor-data/
real_*
actual_*
*-PROD-data.*
*-real-export.*

# --- VS Code (local editor settings, not portable) ---
.vscode/
*.code-workspace

# --- Claude Code local state ---
.claude/

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# --- Editors / OS junk ---
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Backup files ---
*.bak
*.backup
*.orig

# --- Test/coverage outputs ---
coverage/
test-results/
.nyc_output/
.workflow-reference/
