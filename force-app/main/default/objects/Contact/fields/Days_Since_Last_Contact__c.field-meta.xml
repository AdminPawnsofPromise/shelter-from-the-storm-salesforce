<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Contact__c</fullName>
    <description>Days since the most recent Case_Note interaction. Drives "stale cases" alerts and home-page card.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Last_Contact_Date__c), NULL, TODAY() - DATEVALUE(Last_Contact_Date__c))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days Since Last Contact</label>
    <precision>5</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
