<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Checkpoint__c</fullName>
    <description>Which of the three financial counseling checkpoints this session represents: Beginning (at intake), Middle (mid-program review), or End (at exit).</description>
    <inlineHelpText>Per SFTS workflow, financial counseling happens at intake, middle, and exit.</inlineHelpText>
    <label>Checkpoint</label>
    <required>true</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Beginning</fullName>
                <default>true</default>
                <label>Beginning (Intake)</label>
            </value>
            <value>
                <fullName>Middle</fullName>
                <default>false</default>
                <label>Middle (Mid-program)</label>
            </value>
            <value>
                <fullName>End</fullName>
                <default>false</default>
                <label>End (Exit)</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
