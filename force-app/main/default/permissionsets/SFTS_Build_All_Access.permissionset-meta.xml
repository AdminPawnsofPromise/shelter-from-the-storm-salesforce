<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full read/edit access to all SFTS-built custom objects and fields. Assign to build admins. This permission set is updated as new objects and fields are added during the build.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SFTS Build All Access</label>
    <license>Salesforce</license>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Hotline_Call__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Hotline_Call__c.Advocate__c</field>
        <readable>true</readable>
    </fieldPermissions>
