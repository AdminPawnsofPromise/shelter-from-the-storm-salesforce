<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>Before-Save Flow on Case_Note__c insert. When Lana launches the "Log Case Note" quick action from a parent survivor record (Hotline_Call, Shelter_Stay, Financial_Counseling, Self_Sufficiency_Matrix), the new Case_Note has the parent lookup auto-filled by the quick action's targetParentField but Contact__c is still null. This flow looks up the parent's Contact__c and copies it to the new Case_Note so the required Contact__c field is satisfied without Lana having to type it.

Priority order (first match wins): Hotline_Call → Shelter_Stay → FC → SSM. If none of those four parent lookups is set, the flow does nothing and Contact__c remains required (the form validation will prompt Lana for it).</description>
    <environments>Default</environments>
    <interviewLabel>Case Note — Auto-fill Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Note — Auto-fill Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Contact_Already_Set</targetReference>
        </connector>
        <object>Case_Note__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <decisions>
        <name>Contact_Already_Set</name>
        <label>Contact already set?</label>
        <locationX>176</locationX>
        <locationY>140</locationY>
        <defaultConnectorLabel>Contact is null — try parents</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Pick_Parent_Source</targetReference>
        </defaultConnector>
        <rules>
            <name>Contact_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Contact already set — done</label>
        </rules>
    </decisions>
    <decisions>
        <name>Pick_Parent_Source</name>
        <label>Which parent has Contact?</label>
        <locationX>176</locationX>
        <locationY>280</locationY>
        <defaultConnectorLabel>No parent set</defaultConnectorLabel>
        <rules>
            <name>From_Hotline_Call</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Hotline_Call__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Hotline_Call</targetReference>
            </connector>
            <label>Hotline Call set</label>
        </rules>
        <rules>
            <name>From_Shelter_Stay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Shelter_Stay__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Shelter_Stay</targetReference>
            </connector>
            <label>Shelter Stay set</label>
        </rules>
        <rules>
            <name>From_FC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Financial_Counseling__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_FC</targetReference>
            </connector>
            <label>FC set</label>
        </rules>
        <rules>
            <name>From_SSM</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Self_Sufficiency_Matrix__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_SSM</targetReference>
            </connector>
            <label>SSM set</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Hotline_Call</name>
        <label>Get Hotline Call</label>
        <locationX>50</locationX>
        <locationY>420</locationY>
        <connector>
            <targetReference>Set_Contact_From_Hotline_Call</targetReference>
        </connector>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Hotline_Call__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Hotline_Call__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Shelter_Stay</name>
        <label>Get Shelter Stay</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <connector>
            <targetReference>Set_Contact_From_Shelter_Stay</targetReference>
        </connector>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Shelter_Stay__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Shelter_Stay__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_FC</name>
        <label>Get FC</label>
        <locationX>302</locationX>
        <locationY>420</locationY>
        <connector>
            <targetReference>Set_Contact_From_FC</targetReference>
        </connector>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Financial_Counseling__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Financial_Counseling__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_SSM</name>
        <label>Get SSM</label>
        <locationX>428</locationX>
        <locationY>420</locationY>
        <connector>
            <targetReference>Set_Contact_From_SSM</targetReference>
        </connector>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Self_Sufficiency_Matrix__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Self_Sufficiency_Matrix__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contact__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <assignments>
        <name>Set_Contact_From_Hotline_Call</name>
        <label>Set Contact from Hotline Call</label>
        <locationX>50</locationX>
        <locationY>560</locationY>
        <assignmentItems>
            <assignToReference>$Record.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Hotline_Call.Contact__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Contact_From_Shelter_Stay</name>
        <label>Set Contact from Shelter Stay</label>
        <locationX>176</locationX>
        <locationY>560</locationY>
        <assignmentItems>
            <assignToReference>$Record.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Shelter_Stay.Contact__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Contact_From_FC</name>
        <label>Set Contact from FC</label>
        <locationX>302</locationX>
        <locationY>560</locationY>
        <assignmentItems>
            <assignToReference>$Record.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_FC.Contact__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Contact_From_SSM</name>
        <label>Set Contact from SSM</label>
        <locationX>428</locationX>
        <locationY>560</locationY>
        <assignmentItems>
            <assignToReference>$Record.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_SSM.Contact__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
