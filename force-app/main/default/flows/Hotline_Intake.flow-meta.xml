<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Multi-screen wizard for advocates taking a 24/7 hotline call. Captures essential fields, auto-stamps Start_DateTime and current user as Advocate, creates the Hotline_Call__c record, returns confirmation with the autonumber. v1 of the hotline intake flow.</description>
    <environments>Default</environments>
    <interviewLabel>Hotline Intake {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Hotline Intake</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Hotline_Call</name>
        <label>Create Hotline Call</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <inputReference>varHotlineCall</inputReference>
    </recordCreates>
    <screens>
        <name>Caller_Information</name>
        <label>Caller Information</label>
        <locationX>176</locationX>
        <locationY>290</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Call_Details_and_Outcome</targetReference>
        </connector>
        <fields>
            <name>HeaderText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Hotline Call &amp;mdash; Step 1 of 2&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Capture as much as the caller is comfortable sharing. Every field is optional except Caller Type. You can always edit later.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>fld_Caller_Type</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Caller_Type__c</objectFieldReference>
        </fields>
        <fields>
            <name>fld_Caller_Anonymous</name>
            <dataType>Boolean</dataType>
            <fieldText>Caller is anonymous (did not provide a name)</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <fields>
            <name>fld_Caller_Name</name>
            <dataType>String</dataType>
            <fieldText>Caller Name (if given)</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <fields>
            <name>fld_Caller_Phone</name>
            <dataType>String</dataType>
            <fieldText>Caller Phone (if given)</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <fields>
            <name>fld_Phone_Safe</name>
            <dataType>Boolean</dataType>
            <fieldText>Caller confirms it is SAFE to return this number (leave unchecked if in doubt)</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <fields>
            <name>fld_County</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Caller_County__c</objectFieldReference>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Call_Details_and_Outcome</name>
        <label>Call Details and Outcome</label>
        <locationX>176</locationX>
        <locationY>410</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Assign_System_Fields</targetReference>
        </connector>
        <fields>
            <name>HeaderText2</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Hotline Call &amp;mdash; Step 2 of 2&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Describe what the call was about and how it concluded. Outcome is required to close the call.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>fld_Call_Type</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Call_Type__c</objectFieldReference>
        </fields>
        <fields>
            <name>fld_Primary_Issue</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Primary_Issue__c</objectFieldReference>
        </fields>
        <fields>
            <name>fld_Imminent_Danger</name>
            <dataType>Boolean</dataType>
            <fieldText>Imminent danger indicated by caller</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <fields>
            <name>fld_Outcome</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Outcome__c</objectFieldReference>
        </fields>
        <fields>
            <name>fld_Outcome_Notes</name>
            <fieldType>ObjectProvided</fieldType>
            <objectFieldReference>varHotlineCall.Outcome_Notes__c</objectFieldReference>
        </fields>
        <fields>
            <name>fld_Mandatory_Report</name>
            <dataType>Boolean</dataType>
            <fieldText>This call triggered a mandatory report (APS/DCS/LE)</fieldText>
            <fieldType>InputField</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Confirmation_Screen</name>
        <label>Confirmation</label>
        <locationX>176</locationX>
        <locationY>890</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ConfirmationText</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Hotline Call saved.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;You can find and edit this record under the Hotline Calls tab. If a mandatory report or intake follow-up is needed, you&apos;ll do that as a separate step.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <assignments>
        <name>Assign_System_Fields</name>
        <label>Assign System Fields</label>
        <locationX>176</locationX>
        <locationY>530</locationY>
        <assignmentItems>
            <assignToReference>varHotlineCall.Call_Start_DateTime__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Advocate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Caller_Anonymous__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Caller_Anonymous</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Caller_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Caller_Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Caller_Phone__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Caller_Phone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Phone_Safe_To_Return__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Phone_Safe</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Imminent_Danger_Indicated__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Imminent_Danger</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varHotlineCall.Mandatory_Report_Triggered__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fld_Mandatory_Report</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Hotline_Call</targetReference>
        </connector>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Caller_Information</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varHotlineCall</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Hotline_Call__c</objectType>
    </variables>
</Flow>
