<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>On caseman__Intake__c insert: assigns the record to Lana (Executive Director), sends a notification email to director@sftsinc.com with a deep link + key signals, and creates a follow-up Task due tomorrow (today if Risk_Level=High).</description>
    <environments>Default</environments>
    <interviewLabel>Intake — New Submission Workflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Intake — New Submission Workflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_Email_Recipients</targetReference>
        </connector>
        <object>caseman__Intake__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <assignments>
        <name>Add_Email_Recipients</name>
        <label>Build recipient list</label>
        <locationX>176</locationX>
        <locationY>210</locationY>
        <assignmentItems>
            <assignToReference>EmailRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>director@sftsinc.com</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EmailRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>clientadvocate@sftsinc.com</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Notification_Email</targetReference>
        </connector>
    </assignments>
    <variables>
        <name>EmailRecipients</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <actionCalls>
        <name>Send_Notification_Email</name>
        <label>Send Notification Email</label>
        <locationX>176</locationX>
        <locationY>280</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Create_Followup_Task</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddressesArray</name>
            <value>
                <elementReference>EmailRecipients</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>Email_Subject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Email_Body</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <recordCreates>
        <name>Create_Followup_Task</name>
        <label>Create Follow-up Task</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Task_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>005am00000DPSG9AAP</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Task_Due_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <elementReference>Task_Priority</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <formulas>
        <name>Email_Subject</name>
        <dataType>String</dataType>
        <expression>"New SFTS web intake — " &amp; TEXT({!$Record.Risk_Level__c}) &amp; " risk — " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Email_Body</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;A new intake just landed from the website.&lt;/p&gt;" &amp;
"&lt;p&gt;&lt;strong&gt;Risk level:&lt;/strong&gt; " &amp; TEXT({!$Record.Risk_Level__c}) &amp; "&lt;br&gt;" &amp;
"&lt;strong&gt;Shelter requested:&lt;/strong&gt; " &amp; IF({!$Record.Shelter_Requested__c}, "YES", "no") &amp; "&lt;br&gt;" &amp;
"&lt;strong&gt;Children present:&lt;/strong&gt; " &amp; IF({!$Record.Children_Present__c}, "YES (" &amp; TEXT({!$Record.Number_of_Children__c}) &amp; ")", "no") &amp; "&lt;br&gt;" &amp;
"&lt;strong&gt;Referral source:&lt;/strong&gt; " &amp; IF(ISBLANK(TEXT({!$Record.Referral_Source__c})), "(not specified)", TEXT({!$Record.Referral_Source__c})) &amp; "&lt;/p&gt;" &amp;
"&lt;p&gt;&lt;a href=\"https://sftsinc.lightning.force.com/lightning/r/caseman__Intake__c/" &amp; {!$Record.Id} &amp; "/view\"&gt;Open this intake in Salesforce →&lt;/a&gt;&lt;/p&gt;" &amp;
"&lt;p style=\"color: #666; font-size: 0.9em;\"&gt;Owner assigned: Director (Lana Stephens). A follow-up task has been created automatically.&lt;/p&gt;"</expression>
    </formulas>
    <formulas>
        <name>Task_Subject</name>
        <dataType>String</dataType>
        <expression>"Follow up with web intake — " &amp; TEXT({!$Record.Risk_Level__c}) &amp; " risk"</expression>
    </formulas>
    <formulas>
        <name>Task_Due_Date</name>
        <dataType>Date</dataType>
        <expression>IF(TEXT({!$Record.Risk_Level__c}) = "High", TODAY(), TODAY() + 1)</expression>
    </formulas>
    <formulas>
        <name>Task_Priority</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!$Record.Risk_Level__c}) = "High", "High", "Normal")</expression>
    </formulas>
</Flow>
